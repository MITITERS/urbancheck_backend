# Variables de entorno del backend de UrbanCheck.
#
# Es la referencia completa: cada variable figura con su valor por defecto (el
# que usa el código si no se define). En desarrollo los valores viven en
# `.envs/.local/.django` y `.envs/.local/.postgres`, que el compose carga solos.
# En producción van en `.envs/.production/`, que **no se versiona**.
#
# Nunca poner una clave real en este archivo. Las que no tienen default
# (marcadas "obligatoria") hacen fallar el arranque si faltan.

# --- Despliegue (docker-compose.production.yml) -------------------------------
# No la lee Django: la interpola Compose para Traefik, que arma con ella el
# ruteo y los certificados (C-04). Va en el entorno de quien corre Compose o en
# un .env junto al archivo. El panel queda en panel.<dominio>.
URBANCHECK_DOMAIN=urbancheck.com.ar

# --- General ------------------------------------------------------------------
# Obligatoria en producción. Larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# Separados por coma. Default de producción: urbancheck.com.ar. Con el panel
# desplegado (C-04) va también panel.<dominio>: su nginx reenvía ese Host.
DJANGO_ALLOWED_HOSTS=urbancheck.com.ar,panel.urbancheck.com.ar
# Obligatoria en producción. Ruta no predeterminada del admin de Django; `admin/`
# se rechaza al arrancar.
DJANGO_ADMIN_URL=
DJANGO_ADMIN_FORCE_ALLAUTH=False
DJANGO_READ_DOT_ENV_FILE=False
USE_DOCKER=yes

# --- Base de datos, Redis y cache ---------------------------------------------
# Obligatoria. postgres://usuario:clave@host:5432/base
DATABASE_URL=
CONN_MAX_AGE=60
REDIS_URL=redis://redis:6379/0
# Sprint 5: cache compartido de los límites de intentos. Default: REDIS_URL.
DJANGO_CACHE_URL=

# --- HTTPS y orígenes (solo producción) ---------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
# Sprint 5: un año. Para el primer despliegue, 60, y subirlo cuando HTTPS esté
# verificado.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=True
# Sprint 5: vacío = ningún origen cruzado. El panel va por el mismo origen.
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Proxies, límites de intentos y de tasa (Sprint 5, punto 5.1) -------------
# Cuántos proxies propios hay delante de Django (Nginx del panel, Traefik). Con
# 0 se ignora X-Forwarded-For. Detrás de un proxy hay que poner 1 (o 2 si hay
# dos), o todos los límites por IP cuentan la IP del proxy.
DJANGO_NUM_PROXIES=0
# Formato de allauth: cantidad/período/clave (key = la cuenta, ip = la IP).
DJANGO_RATELIMIT_LOGIN_FAILED=10/m/ip,5/15m/key
DJANGO_RATELIMIT_RESET_PASSWORD=20/m/ip,3/h/key
DJANGO_RATELIMIT_CONFIRM_EMAIL=1/3m/key,3/h/key
DJANGO_RATELIMIT_SIGNUP=20/h/ip
# Formato de DRF: cantidad/second|minute|hour|day, por usuario.
DJANGO_THROTTLE_REPORTS=20/hour
DJANGO_THROTTLE_COMMENTS=60/hour
DJANGO_THROTTLE_COMPLAINTS=10/day
DJANGO_THROTTLE_PRIVACY_REQUESTS=5/day
DJANGO_THROTTLE_PUBLIC_REPORTS=120/hour

# --- Registro de seguridad (Sprint 5, punto 5.5) ------------------------------
# Archivo con rotación por tamaño. Vacío = solo consola. Default:
# <raíz del repo>/logs/security.log
DJANGO_SECURITY_LOG_FILE=
DJANGO_SECURITY_LOG_MAX_MB=10
DJANGO_SECURITY_LOG_BACKUP_COUNT=10

# --- Correo -------------------------------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
# Solo producción (C-02): en local, mailpit escucha en 1025 sin credenciales.
# EMAIL_HOST es obligatoria en producción. EMAIL_PORT (default 587) y
# EMAIL_USE_TLS (default True) se agregan solo si el proveedor pide otra cosa.
# Usuario y contraseña van en .envs/.production/.django, nunca acá.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=UrbanCheck <noreply@urbancheck.com.ar>
DJANGO_SERVER_EMAIL=UrbanCheck <noreply@urbancheck.com.ar>
DJANGO_EMAIL_SUBJECT_PREFIX=[UrbanCheck]
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True
DJANGO_ACCOUNT_RESET_PASSWORD_URL=https://urbancheck.com.ar/reset-password?key={key}

# --- Universal Links / App Links ----------------------------------------------
IOS_UNIVERSAL_LINK_APP_ID=TEAMID.com.anonymous.urbancheck
ANDROID_APP_PACKAGE=com.anonymous.urbancheck
# Huellas SHA256 del certificado de firma, separadas por coma.
ANDROID_SHA256_CERT_FINGERPRINTS=

# --- Geocodificación (Nominatim) ----------------------------------------------
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=UrbanCheck/1.0 (contacto: completar)
NOMINATIM_COUNTRYCODES=ar

# --- Reglas del dominio (se leen en cada evaluación) --------------------------
# Vacío = la única municipalidad registrada.
DJANGO_ACTIVE_MUNICIPALITY_ID=
DJANGO_VALIDATION_RADIUS_METERS=50
DJANGO_DUPLICATE_REPORT_RADIUS_METERS=30
DJANGO_COLLECTIVE_VALIDATION_THRESHOLD=10
DJANGO_ARCHIVAL_INACTIVITY_DAYS=90
DJANGO_MAP_RESOLVED_RETENTION_MINUTES=21600
DJANGO_RESOLUTION_OBJECTION_MINUTES=10080
# Desde qué porcentaje de cierres apelados se destaca el indicador (US-050).
DJANGO_STATS_APPEAL_ALERT_PERCENT=20
# Enlace para compartir un reporte (US-030); {token} se reemplaza.
DJANGO_PUBLIC_REPORT_URL=https://urbancheck.com.ar/r/{token}
# A dónde redirige ese enlace a una persona (los bots se quedan con la vista
# previa). En producción, el panel (C-04); en desarrollo:
# http://localhost:5173/reporte/{token}
DJANGO_PUBLIC_REPORT_PAGE_URL=https://panel.urbancheck.com.ar/reporte/{token}
DJANGO_RESOLUTION_OBJECTION_WARNING_MINUTES=1440
DJANGO_PERSONAL_DATA_REVIEW_MINUTES=1440

# --- Fotos y anonimización (US-041, US-042) -----------------------------------
DJANGO_PHOTO_MAX_UPLOAD_MB=15
# Storage privado de las originales a la espera del difuminado: fuera de
# MEDIA_ROOT y fuera de toda ruta servida. Default: <raíz del repo>/pending_media
DJANGO_PENDING_PHOTO_ROOT=
DJANGO_ANONYMIZATION_MAX_RETRIES=3
DJANGO_ANONYMIZATION_RETRY_BASE_SECONDS=30
DJANGO_ANONYMIZATION_STALE_MINUTES=30
# Sprint 5: carpeta NO versionada con el set de referencia del benchmark.
# Default: <raíz del repo>/benchmark_data/anonymization
DJANGO_ANONYMIZATION_REFERENCE_SET=

# --- Comparación de cierres con IA (US-015) -----------------------------------
# Sprint 5: vacío = proveedor nulo, la comparación no se ejecuta y cada cierre
# figura como "comparación no disponible". `openai_compatible` = Gemini, Groq,
# OpenRouter u Ollama, con las variables de abajo.
DJANGO_VISION_PROVIDER=
# Solo en el backend; nunca en un cliente. Vacía con `openai_compatible` = apagada.
DJANGO_RESOLUTION_COMPARISON_API_KEY=
DJANGO_RESOLUTION_COMPARISON_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
DJANGO_RESOLUTION_COMPARISON_MODEL=gemini-3.6-flash
DJANGO_RESOLUTION_COMPARISON_MAX_RETRIES=3
DJANGO_RESOLUTION_COMPARISON_TIMEOUT_SECONDS=30
DJANGO_RESOLUTION_COMPARISON_MAX_SIDE_PX=1024

# --- PostgreSQL del compose (.envs/*/.postgres) -------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=urbancheck
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Flower -------------------------------------------------------------------
CELERY_FLOWER_USER=
CELERY_FLOWER_PASSWORD=
